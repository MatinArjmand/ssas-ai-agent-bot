# Keep using your existing .env when upgrading. This file is only a template.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
QWEN_API_KEY=your-qwen-api-key
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Set QWEN_MODEL to the model you already use with your agent.
QWEN_MODEL=your-existing-qwen-model

# The first database in databases.json reads these settings.
SSAS_SERVER=your-ssas-server-or-ip
SSAS_DATABASE=your-ssas-catalog-name
ADOMD_PATH='C:\path\to\your\ADOMD.NET'

# Optional paths; relative paths are resolved next to telegram_bot.py.
# TELEGRAM_ALLOWED_EMAILS_FILE=allowed_emails.txt
# TELEGRAM_AUTH_DB_FILE=data/bot_auth.sqlite3
# TELEGRAM_DATABASES_FILE=databases.json

# Optional variables for further databases, referenced in databases.json:
# SECOND_SSAS_SERVER=your-second-server-or-ip
# SECOND_SSAS_DATABASE=your-second-catalog-name
