TELEGRAM_BOT_TOKEN=
TELEGRAM_CONCURRENT_UPDATES=16

# One GLOBAL AI provider/model for every user and database.
# Supported: qwen, gemini, openai, deepseek, custom
AI_PROVIDER=custom
AI_TIMEOUT_SECONDS=60
AI_MAX_AGENT_STEPS=12

# requesty api : https://app.requesty.ai/api-keys
CUSTOM_API_KEY=
CUSTOM_BASE_URL=https://router.requesty.ai/v1
CUSTOM_MODEL=mistral/leanstral-1-5
#mistral/leanstral-1-5 -- nvidia/nemotron-3-ultra-550b-a55b -- nvidia/muse-glimmer-30b
#nvidia/nemotron-3.5-lightning-30b-a3b
CUSTOM_TEMPERATURE=default

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash
QWEN_DISABLE_THINKING=true
QWEN_TEMPERATURE=0

# GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GEMINI_MODEL=
# GEMINI_TEMPERATURE=default

# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=
# OPENAI_TEMPERATURE=default

# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=
# DEEPSEEK_TEMPERATURE=default

# SSAS database values referenced by the supplied databases.json
SSAS_SERVER=
SSAS_DATABASE=

SECOND_SSAS_SERVER=
SECOND_SSAS_DATABASE=

# Folder containing Microsoft.AnalysisServices.AdomdClient.dll
ADOMD_PATH='C:\path\to\your\ADOMD.NET'

# Read-only MCP guardrails
MAX_RESULT_ROWS=500
DEFAULT_RESULT_ROWS=100
MAX_RESULT_CHARS=200000
MAX_METADATA_ROWS=200000
SCHEMA_CHAR_BUDGET=120000
MAX_COLUMNS_PER_TABLE=200
MAX_MEASURES_PER_TABLE=200
MAX_EXPRESSION_CHARS=400
INCLUDE_HIDDEN=false
CONNECT_TIMEOUT_SECONDS=30
QUERY_TIMEOUT_SECONDS=120
REQUEST_MEMORY_LIMIT_KB=0
MAX_DAX_CHARS=20000
SCHEMA_CACHE_TTL_SECONDS=86400

# Optional application paths (relative to this project if not absolute)
# TELEGRAM_ALLOWED_EMAILS_FILE=allowed_emails.json
# TELEGRAM_AUTH_DB_FILE=data/bot_auth.sqlite3
# TELEGRAM_DATABASES_FILE=databases.json
