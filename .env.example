TELEGRAM_BOT_TOKEN=

# Supported: qwen, gemini, custom, openai, deepseek, custom. Default: qwen.
AI_PROVIDER=custom

# Each provider uses only its own API key/model/URL. Keep multiple sets here.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash

# Gemini: uncomment and set these before choosing AI_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# requesty api
CUSTOM_API_KEY=
CUSTOM_BASE_URL=https://router.requesty.ai/v1
CUSTOM_MODEL=mistral/leanstral-1-5
#mistral/leanstral-1-5 -- nvidia/nemotron-3-ultra-550b-a55b -- nvidia/muse-glimmer-30b
#nvidia/nemotron-3.5-lightning-30b-a3b
CUSTOM_JSON_MODE=true

# OpenAI: use a text model that supports Chat Completions and JSON output.
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=your-openai-model-name
# OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek:
# DEEPSEEK_API_KEY=your-deepseek-api-key
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Other services exposing the OpenAI Chat Completions API:
# CUSTOM_API_KEY=your-provider-api-key
# CUSTOM_MODEL=your-provider-model-name
# CUSTOM_BASE_URL=https://your-provider.example/v1

# Optional request settings. Existing Qwen behavior is retained by default.
# AI_TIMEOUT_SECONDS=60
# QWEN_DISABLE_THINKING=true
# QWEN_TEMPERATURE=0
# GEMINI_TEMPERATURE=default
# OPENAI_TEMPERATURE=default
# DEEPSEEK_TEMPERATURE=default
# CUSTOM_TEMPERATURE=default
# Set <PROVIDER>_JSON_MODE=false ONLY if that service rejects response_format.
# It must still return valid JSON as instructed by the agent's prompts.
# CUSTOM_JSON_MODE=true

# The first database in databases.json reads these settings.
SSAS_SERVER=
SSAS_DATABASE=
ADOMD_PATH='C:\path\to\your\ADOMD.NET'

# Optional paths; relative paths are resolved next to telegram_bot.py.
# TELEGRAM_ALLOWED_EMAILS_FILE=allowed_emails.txt
# TELEGRAM_AUTH_DB_FILE=data/bot_auth.sqlite3
# TELEGRAM_DATABASES_FILE=databases.json

# Optional variables for further databases, referenced in databases.json:
SECOND_SSAS_SERVER=
SECOND_SSAS_DATABASE=
